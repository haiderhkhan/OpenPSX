# Base URL for the OPEN PSX FastAPI backend (Track A server runs on http://127.0.0.1:8000)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# When true, the API client reads static contract fixtures from src/mocks/ instead of fetching the backend
NEXT_PUBLIC_USE_MOCKS=false

# Only for a *.app.github.dev (Codespaces) API_BASE: false stops sending X-Tunnel-Skip-AntiPhishing-Page (docs/CODESPACES.md)
NEXT_PUBLIC_TUNNEL_SKIP_HEADER=true

