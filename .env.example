# OPEN PSX backend environment — copy to .env and fill in. Never commit .env.
# Every variable is optional: the backend starts with defaults and runs in template mode without keys.

# Comma-separated Gemini API keys, tried in failover order. Quota is per Google Cloud project.
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
# Single Gemini model ID for all agents (R-04). gemini-3* -> thinking_level, gemini-2.5* -> thinking_budget=0.
GEMINI_MODEL=gemini-3.1-flash-lite
# Groq API key for Whisper voice transcription.
GROQ_API_KEY=your-groq-key
# Groq Whisper model ID (confirm in research R-04), e.g. a whisper-large-v3* model.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Kill switch: false makes every LLM feature use its deterministic template.
LLM_ENABLED=true
# Soft daily cap on LLM calls (PKT day, per process); above it, features fall back to templates.
LLM_DAILY_CALL_LIMIT=200

# SQLite paths, relative to the repo root.
DB_PATH=data/openpsx.db
CACHE_DB_PATH=data/cache.db
# App timezone (zoneinfo name).
APP_TZ=Asia/Karachi
# Comma-separated allowed CORS origins; add the Vercel URL in P8-03.
CORS_ORIGINS=http://localhost:3000

# Feature flags = drop order (#1..#4). Set to false to drop a feature.
# 1: ETF coverage
FEATURE_ETFS=true
# 2: Macro LLM brief (false -> macro template)
FEATURE_MACRO_LLM=true
# 3: Fiscal-year basis toggle (false -> basis=fiscal returns FEATURE_OFF)
FEATURE_FISCAL_TOGGLE=true
# 4: Whisper voice input (false -> transcribe returns FEATURE_OFF)
FEATURE_VOICE=true
